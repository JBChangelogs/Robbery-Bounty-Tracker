---
import "../styles/global.css";

interface Props {
  title?: string;
  backgroundUrl?: string;
}

const { title = "Join Roblox Server - Jailbreak Changelogs", backgroundUrl } =
  Astro.props;

const umamiScript = import.meta.env.PUBLIC_UMAMI_SCRIPT_NAME;
const umamiUrl = umamiScript
  ? `https://umami.jailbreakchangelogs.xyz${umamiScript.startsWith("/") ? umamiScript : `/${umamiScript}`}`
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    {
      umamiUrl && (
        <script
          defer
          src={umamiUrl}
          data-website-id="3c3f84af-6cc9-4d39-86c8-374da4351a11"
        />
      )
    }
  </head><body>
    <div class="bg-overlay"></div>
    <div class="bg-vignette"></div>
    <slot />
  </body>
</html>
