---
import { Image } from "astro:assets";
import Logo from "./Logo.astro";

// Error state component
---

<div id="error-state" class="hidden">
  <div class="flex flex-col items-center">
    <Logo />

    <img src="/404.svg" alt="404" class="error-image mb-8" />

    <div class="mb-8 text-center w-full">
      <span class="text-secondary text-sm font-bold tracking-wider uppercase"
        >404 Error</span
      >
      <h1 class="text-xl">Connection Error</h1>
      <p class="error-message">
        Unable to connect to the server. The jobid parameter is missing from the
        URL.
      </p>
    </div>

    <a
      href="https://jailbreakchangelogs.xyz/"
      target="_blank"
      rel="noopener noreferrer"
      class="primary-button w-full"
    >
      Back to Website
    </a>

    <a
      href="https://jailbreakchangelogs.xyz/"
      target="_blank"
      class="footer-brand"
    >
      <span>Powered by Jailbreak Changelogs</span>
    </a>
  </div>
</div>
