---
import Logo from "./Logo.astro";

// Joining state component
---

<div id="joining-state" class="hidden">
  <div class="flex flex-col items-center">
    <Logo />
    <h1 class="text-xl">Joining Jailbreak</h1>
    <p>Launching the game instance...</p>

    <div class="spinner-container">
      <div class="spinner"></div>
    </div>

    <div id="troubleshoot" class="flex flex-col items-center">
      <a
        id="browser-join-link"
        href="#"
        target="_blank"
        class="secondary-link"
        data-umami-event="browser-join-click"
      >
        App unsupported? Try Browser
      </a>
    </div>

    <div
      id="auto-close-container"
      class="mt-6 flex flex-col items-center pt-6 border-t border-white/10 w-full"
    >
      <div class="flex items-center justify-center w-full mb-3 px-1">
        <div class="text-center">
          <p
            id="auto-close-countdown"
            class="text-[13px] font-semibold text-white font-mono"
          >
            Closing in 10 seconds
          </p>
          <p class="text-[10px] text-secondary">You can close this tab now.</p>
        </div>
      </div>

      <div class="progress-bar-container">
        <div id="progress-bar" class="progress-bar"></div>
      </div>

      <button
        id="cancel-auto-close"
        class="mt-4 text-[10px] uppercase tracking-wider font-bold opacity-40 hover:opacity-100 transition-opacity cursor-pointer text-white/60 bg-transparent border-none"
      >
        Keep this tab open
      </button>

      <div
        id="fallback-message"
        class="hidden mt-3 text-[10px] text-yellow-500/80 text-center"
      >
        The browser blocked automatic tab closing.
      </div>
    </div>

    <a
      href="https://jailbreakchangelogs.xyz/"
      target="_blank"
      class="footer-brand"
    >
      <span>Powered by Jailbreak Changelogs</span>
    </a>
  </div>
</div>

<style>
  .mt-6 {
    margin-top: 1.5rem;
  }
  .mt-4 {
    margin-top: 1rem;
  }
  .mt-3 {
    margin-top: 0.75rem;
  }
  .pt-6 {
    padding-top: 1.5rem;
  }
  .mb-3 {
    margin-bottom: 0.75rem;
  }
  .px-1 {
    padding-left: 0.25rem;
    padding-right: 0.25rem;
  }
  .border-t {
    border-top-width: 1px;
  }
  .border-white\/10 {
    border-color: rgba(255, 255, 255, 0.1);
  }
  .text-secondary {
    color: var(--color-secondary-text);
  }
  .text-white {
    color: white;
  }
  .text-white\/60 {
    color: rgba(255, 255, 255, 0.6);
  }
  .text-yellow-500\/80 {
    color: rgba(234, 179, 8, 0.8);
  }
  .text-\[13px\] {
    font-size: 13px;
  }
  .text-\[10px\] {
    font-size: 10px;
  }
  .tracking-wider {
    letter-spacing: 0.05em;
  }
  .uppercase {
    text-transform: uppercase;
  }
  .font-semibold {
    font-weight: 600;
  }
  .font-bold {
    font-weight: 700;
  }
  .cursor-pointer {
    cursor: pointer;
  }
  .rounded-md {
    border-radius: 0.375rem;
  }
  .bg-white\/10 {
    background-color: rgba(255, 255, 255, 0.1);
  }
  .hover\:bg-white\/20:hover {
    background-color: rgba(255, 255, 255, 0.2);
  }
  .bg-transparent {
    background-color: transparent;
  }
  .border-none {
    border: none;
  }

  .progress-bar-container {
    width: 100%;
    height: 6px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 99px;
    overflow: hidden;
  }

  .progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(
      90deg,
      var(--color-button-info),
      var(--color-link)
    );
    border-radius: 99px;
    transition: width 0.1s linear;
  }
</style>
